<Application x:Class="Starboard.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#1A1B26" />
        <SolidColorBrush x:Key="ForegroundBrush" Color="#C0CAF5" />
        <SolidColorBrush x:Key="RuleBrush" Color="#343B58" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7DCFFF" />
    </Application.Resources>
</Application>
