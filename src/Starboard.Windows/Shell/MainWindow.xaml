<Window x:Class="Starboard.Windows.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="pack://application:,,,/Starboard;component/Assets/Starboard.ico"
        Title="Starboard"
        Width="900"
        Height="200"
        MinWidth="300"
        MinHeight="96"
        AllowsTransparency="False"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="False"
        WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="PanelBorder"
            BorderBrush="{StaticResource RuleBrush}"
            BorderThickness="1,1,1,0">
        <Grid>
            <ContentPresenter x:Name="TerminalContent" />
        </Grid>
    </Border>
</Window>
