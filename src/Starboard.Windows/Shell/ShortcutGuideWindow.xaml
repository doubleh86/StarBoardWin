<Window x:Class="Starboard.Windows.Shell.ShortcutGuideWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Starboard 단축키 안내"
        Width="640"
        Height="620"
        MinWidth="520"
        MinHeight="480"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="HandlePreviewKeyDown">
    <DockPanel Background="#1A1B26" KeyboardNavigation.TabNavigation="Cycle">
        <Button x:Name="CloseButton"
                DockPanel.Dock="Bottom"
                Width="88"
                Margin="24,0,24,24"
                HorizontalAlignment="Right"
                Click="HandleCloseClick"
                Content="닫기" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#C0CAF5" Text="단축키 안내" />
                <TextBlock Margin="0,8,0,20" Foreground="#A9B1D6" TextWrapping="Wrap"
                           Text="전역 단축키는 Windows에 실제로 등록된 경우에만 동작합니다." />
                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#C0CAF5" Text="전역 단축키" />
                <Grid Margin="0,8,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Foreground="#A9B1D6" Text="패널 호출" />
                    <TextBlock x:Name="ActivationShortcutText" Grid.Column="1" Foreground="#C0CAF5" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Margin="0,10,0,0" Foreground="#A9B1D6" Text="확장 / 복원" />
                    <TextBlock x:Name="ExpandShortcutText" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Foreground="#C0CAF5" TextWrapping="Wrap" />
                </Grid>
                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#C0CAF5" Text="터미널 입력" />
                <TextBlock Margin="0,8,0,0" Foreground="#C0CAF5" Text="Ctrl+Shift+T  새 탭" />
                <TextBlock Margin="0,6,0,0" Foreground="#C0CAF5" Text="Ctrl+Tab / Ctrl+Shift+Tab  다음 / 이전 탭" />
                <TextBlock Margin="0,6,0,0" Foreground="#C0CAF5" Text="Ctrl+Shift+W  현재 탭 닫기 (확인 후 종료)" />
                <TextBlock Margin="0,6,0,0" Foreground="#C0CAF5" Text="Ctrl+C  선택 영역 복사, 선택이 없으면 shell에 interrupt 전달" />
                <TextBlock Margin="0,6,0,0" Foreground="#C0CAF5" Text="Ctrl+V  클립보드 붙여넣기 (여러 줄은 확인 필요)" />
                <TextBlock Margin="0,18,0,0" Foreground="#7F8BB3" TextWrapping="Wrap"
                           Text="Escape 또는 닫기 버튼으로 이 창을 닫을 수 있습니다." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
