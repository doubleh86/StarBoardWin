<UserControl x:Class="Starboard.Modules.Preferences.Presentation.SettingsEditorView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="520"
             MinHeight="620"
             FontFamily="Segoe UI Variable Text, Segoe UI">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#1A1B26" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#24283B" />
        <SolidColorBrush x:Key="ForegroundBrush" Color="#C0CAF5" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A9B1D6" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7DCFFF" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#F7768E" />
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#3B4261" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="#3B4261" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource CanvasBrush}" Padding="24">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
                <TextBlock Foreground="{StaticResource ErrorBrush}"
                           Text="{Binding SaveError}"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="기본값 복원" Click="RestoreDefaultsButton_Click" />
                    <Button Content="취소" IsCancel="True" Click="CancelButton_Click" />
                    <Button Content="저장" IsDefault="True" Background="{StaticResource AccentBrush}" Click="SaveButton_Click" />
                </StackPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Starboard 설정" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource ForegroundBrush}" />
                    <TextBlock Margin="0,6,0,20" Text="변경 사항은 저장할 때만 적용됩니다." Foreground="{StaticResource MutedBrush}" />

                    <GroupBox Header="화면" Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,16">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="테마" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" SelectedItem="{Binding Theme, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Themes}" />
                            <TextBlock Grid.Row="1" Text="축소 높이 (DIP)" VerticalAlignment="Center" Margin="0,12,0,0" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"><TextBox Text="{Binding CollapsedHeightText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" /><TextBlock Text="{Binding CollapsedHeightError}" Foreground="{StaticResource ErrorBrush}" /></StackPanel>
                            <TextBlock Grid.Row="2" Text="글꼴" VerticalAlignment="Center" Margin="0,12,0,0" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"><TextBox Text="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" /><TextBlock Text="{Binding FontFamilyError}" Foreground="{StaticResource ErrorBrush}" /></StackPanel>
                            <TextBlock Grid.Row="3" Text="글꼴 크기" VerticalAlignment="Center" Margin="0,12,0,0" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,8,0,0"><TextBox Text="{Binding FontSizeText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" /><TextBlock Text="{Binding FontSizeError}" Foreground="{StaticResource ErrorBrush}" /></StackPanel>
                            <TextBlock Grid.Row="4" Text="불투명도 (0.72–1.00)" VerticalAlignment="Center" Margin="0,12,0,0" />
                            <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,8,0,0"><TextBox Text="{Binding OpacityText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" /><TextBlock Text="{Binding OpacityError}" Foreground="{StaticResource ErrorBrush}" /></StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="터미널" Foreground="{StaticResource ForegroundBrush}" Margin="0,0,0,16">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="새 탭 기본 셸" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"><TextBox Text="{Binding ShellExecutable, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" /><TextBlock Text="{Binding ShellExecutableError}" Foreground="{StaticResource ErrorBrush}" /><TextBlock Text="비워 두면 PowerShell을 자동으로 찾습니다." Foreground="{StaticResource MutedBrush}" /></StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="동작" Foreground="{StaticResource ForegroundBrush}">
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <CheckBox Content="Windows 로그인 시 시작" IsChecked="{Binding StartWithWindows}" Grid.ColumnSpan="2" />
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,4">
                                <CheckBox Content="다음 실행 시 탭 구성 복원"
                                          IsChecked="{Binding RestoreWorkspaceOnLaunch}" />
                                <TextBlock Margin="22,4,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="이름·순서·시작 폴더를 로컬 파일에 저장합니다. 실행 중인 명령, 출력, 환경, 클립보드는 저장하거나 복원하지 않습니다."
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="22,3,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           Text="옵션을 끄고 저장하면 현재 세션은 유지하고 저장된 구성과 백업 삭제를 시도합니다."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="표시 모니터" VerticalAlignment="Center" Margin="0,12,0,0" />
                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" SelectedItem="{Binding PreferredMonitor}" ItemsSource="{Binding PreferredMonitors}" />
                            <TextBlock Grid.Row="3" Text="확장 단축키" VerticalAlignment="Center" Margin="0,12,0,0" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,8,0,0"><TextBox Text="{Binding ExpandShortcut, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" /><TextBlock Text="{Binding ExpandShortcutError}" Foreground="{StaticResource ErrorBrush}" /></StackPanel>
                            <TextBlock Grid.Row="4" Text="호출/숨김 단축키" VerticalAlignment="Center" Margin="0,12,0,0" />
                            <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,8,0,0"><TextBox Text="{Binding ActivationShortcut, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" /><TextBlock Text="{Binding ActivationShortcutError}" Foreground="{StaticResource ErrorBrush}" /></StackPanel>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
