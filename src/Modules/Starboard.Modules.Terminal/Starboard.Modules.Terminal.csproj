<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Starboard.SharedKernel\Starboard.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Presentation\Renderer\dist\**\*" />
    <Content Include="Presentation\Renderer\dist\**\*"
             CopyToOutputDirectory="PreserveNewest"
             Link="Renderer\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
