<UserControl x:Class="Starboard.Modules.Terminal.Presentation.TerminalView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource CanvasBrush}"
             Focusable="False">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#1A1B26" />
        <SolidColorBrush x:Key="ForegroundBrush" Color="#C0CAF5" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9DA5C3" />
        <SolidColorBrush x:Key="RuleBrush" Color="#343B58" />
        <SolidColorBrush x:Key="RuleStrongBrush" Color="#4A5274" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7DCFFF" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#94D8FF" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#62BCEB" />
        <SolidColorBrush x:Key="ButtonInkBrush" Color="#0C1720" />
        <SolidColorBrush x:Key="ButtonInkDarkBrush" Color="#0C1720" />
        <SolidColorBrush x:Key="ButtonInkLightBrush" Color="#F3F1EB" />
        <SolidColorBrush x:Key="FocusBrush" Color="#E0AF68" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#F7768E" />
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Cascadia Code, Consolas</FontFamily>
        <Style x:Key="RetryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonInkBrush}" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FocusRing"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                Padding="2">
                            <Border x:Name="ButtonSurface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource RuleStrongBrush}" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource RuleStrongBrush}" />
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <wv2:WebView2 x:Name="Renderer"
                      AllowExternalDrop="False"
                      CreationProperties="{x:Null}"
                      Visibility="Collapsed" />

        <Border x:Name="StatusSurface"
                Background="{DynamicResource CanvasBrush}"
                BorderBrush="{DynamicResource RuleBrush}"
                BorderThickness="0">
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusHeading"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundBrush}"
                               Text="STARBOARD / STARTING" />
                    <TextBlock x:Name="StatusMessage"
                               Margin="0,8,0,0"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"
                               Text="로컬 renderer와 shell session을 준비하고 있습니다."
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </StackPanel>
                <Button x:Name="RetryButton"
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Click="RetryButton_Click"
                        Content="다시 시작"
                        Style="{StaticResource RetryButtonStyle}"
                        Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
