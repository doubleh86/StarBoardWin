<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>Starboard for Windows</Product>
    <StarboardBuildCommit Condition="'$(StarboardBuildCommit)' == ''">unknown</StarboardBuildCommit>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion Condition="'$(StarboardBuildCommit)' == 'unknown'">$(Version)</InformationalVersion>
    <InformationalVersion Condition="'$(StarboardBuildCommit)' != 'unknown'">$(Version)+$(StarboardBuildCommit)</InformationalVersion>
  </PropertyGroup>
</Project>
